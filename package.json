    "semanticTokenTypes": [
      {
        "id": "noun",
        "description": "名詞",
        "superType": "variable"
      },
      {
        "id": "verb",
        "description": "動詞",
        "superType": "function"
      },
      {
        "id": "adjective",
        "description": "形容詞",
        "superType": "property"
      },
      {
        "id": "particle",
        "description": "助詞",
        "superType": "keyword"
      },
      {
        "id": "adverb",
        "description": "副詞",
        "superType": "parameter"
      },
      {
        "id": "other",
        "description": "その他",
        "superType": "string"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "noun": [
            "entity.name.variable.japanese"
          ],
          "verb": [
            "entity.name.function.japanese"
          ],
          "adjective": [
            "entity.name.property.japanese"
          ],
          "particle": [
            "keyword.other.japanese"
          ],
          "adverb": [
            "support.variable.japanese"
          ],
          "other": [
            "string.japanese"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
          "noun": {
            "foreground": "#A8D8B9"
          },
          "verb": {
            "foreground": "#F7DC6F"
          },
          "adjective": {
            "foreground": "#AED6F1"
          },
          "particle": {
            "foreground": "#D7BDE2"
          },
          "adverb": {
            "foreground": "#F5B7B1"
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node scripts/prepare-package.js && npm run esbuild-base -- --production",
    "compile": "npm run esbuild-base",
    "esbuild-base": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "compile:tsc": "tsc -b",
    "lint": "eslint \"client/src/**/*.ts\" \"server/src/**/*.ts\" \"shared/src/**/*.ts\"",
    "lint:fix": "eslint \"client/src/**/*.ts\" \"server/src/**/*.ts\" \"shared/src/**/*.ts\" --fix",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:coverage": "jest --config jest.config.js --coverage",
    "evals": "ts-node server/src/grammar/evals/run-evals.ts",
    "evals:update-readme": "ts-node server/src/grammar/evals/update-readme.ts",
    "check:readme": "ts-node scripts/check-readme.ts",
    "check:glossary": "ts-node scripts/check-glossary-coverage.ts",
    "check:glossary:all": "ts-node scripts/check-glossary-all.ts",
    "audit:glossary": "ts-node scripts/audit-glossary.ts",
    "docs:config": "ts-node scripts/generate-config-doc.ts",
    "check:config": "ts-node scripts/generate-config-doc.ts --check",
    "docs:rules": "ts-node scripts/generate-rules-doc.ts",
    "check:rules": "ts-node scripts/generate-rules-doc.ts --check",
    "docs:all": "npm run docs:config && npm run docs:rules",
    "check:consistency": "ts-node scripts/generate-config-doc.ts --check && ts-node scripts/generate-rules-doc.ts --check && ts-node scripts/audit-glossary.ts --strict",
    "clean": "rimraf ./client/out ./server/out ./shared/out",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.0",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^18.15.0",
    "@types/vscode": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^3.15.0",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "kuromoji-optimized": "github:tsuyoshi-otake/kuromoji-optimized",
    "vscode-languageclient": "^9.0.0",
    "vscode-languageserver": "^9.0.0",
    "vscode-languageserver-textdocument": "^1.0.0"
  },
  "overrides": {
    "vscode-languageclient": {
      "minimatch": {
        ".": "5.1.9",
        "brace-expansion": "2.1.1"
      }
    },
    "async": {
      "lodash": "4.18.1"
    },
    "@vscode/vsce": {
      "cheerio": "1.0.0"
    }
  }
}
