{
  "name": "otak-lsp",
  "displayName": "otak-lsp",
  "description": "日本語形態素解析VSCode拡張機能（外部依存なし）。文法チェック、セマンティックハイライト、ホバー情報を提供します。kuromoji.js内蔵でMeCab不要。",
  "version": "0.8.1",
  "publisher": "odangoo",
  "license": "MIT",
  "icon": "images/otak-lsp.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsuyoshi-otake-system-exe-jp/otak-lsp"
  },
  "bugs": {
    "url": "https://github.com/tsuyoshi-otake-system-exe-jp/otak-lsp/issues"
  },
  "homepage": "https://github.com/tsuyoshi-otake-system-exe-jp/otak-lsp#readme",
  "galleryBanner": {
    "color": "#F5F5F5",
    "theme": "light"
  },
  "keywords": [
    "japanese",
    "grammar",
    "mecab",
    "morphological-analysis",
    "linter",
    "semantic-highlighting"
  ],
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./client/out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "otakLsp.toggle",
        "title": "otak-lsp: ON/OFF切り替え"
      },
      {
        "command": "otakLsp.showStatus",
        "title": "otak-lsp: ステータス表示"
      },
      {
        "command": "otakLsp.analyzeCurrentFile",
        "title": "otak-lsp: 現在のファイルを解析"
      },
      {
        "command": "otakLsp.setTheme",
        "title": "otak-lsp: セマンティックテーマを設定"
      },
      {
        "command": "otakLsp.selectTheme",
        "title": "otak-lsp: セマンティックテーマを選択"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "otak-lsp",
      "properties": {
        "otakLsp.enableGrammarCheck": {
          "type": "boolean",
          "default": true,
          "description": "文法チェック機能の有効/無効。二重助詞、助詞連続、動詞-助詞不整合を検出します。",
          "scope": "resource"
        },
        "otakLsp.enableSemanticHighlight": {
          "type": "boolean",
          "default": true,
          "description": "品詞ベースのセマンティックハイライト機能の有効/無効",
          "scope": "resource"
        },
        "otakLsp.excludeTableDelimiters": {
          "type": "boolean",
          "default": true,
          "description": "Markdownテーブル内のセマンティックハイライトを有効にします。falseにすると従来通りテーブル全体をハイライト対象外にします。",
          "scope": "resource"
        },
        "otakLsp.markdown.analyzeCodeBlocks": {
          "type": "boolean",
          "default": true,
          "description": "Markdownのコードブロック（```）内も文法チェック/セマンティックハイライト対象にします（※一部の文脈依存ルールは本文のみ）。",
          "scope": "resource"
        },
        "otakLsp.markdown.analyzeTables": {
          "type": "boolean",
          "default": true,
          "description": "Markdownのテーブル（|...|）内も文法チェック対象にします。",
          "scope": "resource"
        },
        "otakLsp.targetLanguages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "markdown",
              "javascript",
              "typescript",
              "python",
              "c",
              "cpp",
              "java",
              "rust",
              "plaintext"
            ]
          },
          "default": [
            "markdown",
            "javascript",
            "typescript",
            "python",
            "c",
            "cpp",
            "java",
            "rust",
            "plaintext"
          ],
          "description": "解析対象のファイルタイプ。プログラミング言語ではコメント内の日本語を解析します。",
          "scope": "resource"
        },
        "otakLsp.debounceDelay": {
          "type": "number",
          "default": 250,
          "minimum": 100,
          "maximum": 5000,
          "description": "テキスト編集後に解析を開始するまでの遅延時間（ミリ秒）",
          "scope": "resource"
        },
        "otakLsp.hover.enableWikipedia": {
          "type": "boolean",
          "default": true,
          "description": "ホバーにWikipediaサマリーを表示します（取得失敗時は表示しません）。",
          "scope": "resource"
        },
        "otakLsp.hover.enableGlossary": {
          "type": "boolean",
          "default": true,
          "description": "ホバーに用語図鑑（オフライン）を表示します。Wikipediaサマリーの下に表示されます。",
          "scope": "resource"
        },
        "otakLsp.hover.enabledGlossaries": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "it",
              "otakLspSettings",
              "cloud",
              "backend",
              "frontend",
              "ddd",
              "tdd",
              "pmbok",
              "java",
              "nextjs",
              "dotnet",
              "security",
              "networkHttp",
              "authIam",
              "dbSqlTx",
              "apiDesign",
              "devopsCicd",
              "containersK8s",
              "observabilitySre",
              "distributedSystems",
              "messagingEda",
              "performanceCache",
              "architecturePatterns",
              "agileProduct",
              "aiLlm",
              "contractLegal",
              "iotEmbedded",
              "awsServices",
              "azureServices",
              "gcpServices",
              "ociServices",
              "cloudflareServices"
            ]
          },
          "default": [
            "it",
            "otakLspSettings",
            "cloud",
            "backend",
            "frontend",
            "ddd",
            "tdd",
            "pmbok",
            "java",
            "nextjs",
            "dotnet",
            "security",
            "networkHttp",
            "authIam",
            "dbSqlTx",
            "apiDesign",
            "devopsCicd",
            "containersK8s",
            "observabilitySre",
            "distributedSystems",
            "messagingEda",
            "performanceCache",
            "architecturePatterns",
            "agileProduct",
            "aiLlm",
            "contractLegal",
            "iotEmbedded",
            "awsServices",
            "azureServices",
            "gcpServices",
            "ociServices",
            "cloudflareServices"
          ],
          "description": "ホバーで表示する用語図鑑のカテゴリ。",
          "scope": "resource"
        },
        "otakLsp.sentenceSplitMode": {
          "type": "string",
          "enum": [
            "strict",
            "normal",
            "loose"
          ],
          "default": "normal",
          "description": "文分割モード。strict: 改行を常に文の区切りとして扱う、normal: 文脈を考慮して判断（推奨）、loose: 段落区切り（空行）のみを文の区切りとして扱う",
          "scope": "resource"
        },
        "otakLsp.advanced.enableStyleConsistency": {
          "type": "boolean",
          "default": true,
          "description": "文体の混在検出（敬体/常体）の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableRaNukiDetection": {
          "type": "boolean",
          "default": true,
          "description": "ら抜き言葉検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableDoubleNegation": {
          "type": "boolean",
          "default": true,
          "description": "二重否定検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableParticleRepetition": {
          "type": "boolean",
          "default": true,
          "description": "同じ助詞の連続使用検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableConjunctionRepetition": {
          "type": "boolean",
          "default": true,
          "description": "同じ接続詞の連続使用検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableAdversativeGa": {
          "type": "boolean",
          "default": true,
          "description": "逆接「が」の連続使用検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableAlphabetWidth": {
          "type": "boolean",
          "default": true,
          "description": "全角/半角アルファベット混在検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableWeakExpression": {
          "type": "boolean",
          "default": true,
          "description": "弱い表現検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableCommaCount": {
          "type": "boolean",
          "default": true,
          "description": "読点数チェックの有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableTermNotation": {
          "type": "boolean",
          "default": true,
          "description": "技術用語表記統一の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.customNotationRules": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "技術用語表記統一（Term Notation）のカスタム辞書。キーが誤った表記、値が正しい表記（例: { \"Nodejs\": \"Node.js\" }）。",
          "scope": "resource"
        },
        "otakLsp.advanced.enableKanjiOpening": {
          "type": "boolean",
          "default": true,
          "description": "漢字開き検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableWebTechDictionary": {
          "type": "boolean",
          "default": true,
          "description": "ウェブ技術用語辞典の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableGenerativeAIDictionary": {
          "type": "boolean",
          "default": true,
          "description": "生成AI関連用語辞典の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableAWSDictionary": {
          "type": "boolean",
          "default": true,
          "description": "AWS関連用語辞典の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableAzureDictionary": {
          "type": "boolean",
          "default": true,
          "description": "Azure関連用語辞典の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableOCIDictionary": {
          "type": "boolean",
          "default": true,
          "description": "OCI関連用語辞典の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.commaCountThreshold": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 20,
          "description": "1文中の読点数の閾値（この値を超えると警告）",
          "scope": "resource"
        },
        "otakLsp.advanced.weakExpressionLevel": {
          "type": "string",
          "enum": [
            "strict",
            "normal",
            "loose"
          ],
          "default": "normal",
          "description": "弱い表現の検出レベル（strict: 厳格、normal: 標準、loose: 緩め）",
          "scope": "resource"
        },
        "otakLsp.advanced.enableRedundantExpression": {
          "type": "boolean",
          "default": true,
          "description": "冗長表現検出の有効/無効（「馬から落馬する」「一番最初」など）",
          "scope": "resource"
        },
        "otakLsp.advanced.enableTautology": {
          "type": "boolean",
          "default": true,
          "description": "重複表現（同語反復）検出の有効/無効（「頭痛が痛い」「違和感を感じる」など）",
          "scope": "resource"
        },
        "otakLsp.advanced.enableNoParticleChain": {
          "type": "boolean",
          "default": true,
          "description": "助詞「の」連続使用検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableMonotonousEnding": {
          "type": "boolean",
          "default": true,
          "description": "文末表現の単調さ検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableLongSentence": {
          "type": "boolean",
          "default": true,
          "description": "長すぎる文の検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableSahenVerb": {
          "type": "boolean",
          "default": true,
          "description": "サ変動詞の誤用検出（「勉強をする」→「勉強する」など）の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableMissingSubject": {
          "type": "boolean",
          "default": true,
          "description": "主語の欠如検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableTwistedSentence": {
          "type": "boolean",
          "default": true,
          "description": "ねじれ文の検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableHomophone": {
          "type": "boolean",
          "default": true,
          "description": "同音異義語の誤用検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableHonorificError": {
          "type": "boolean",
          "default": true,
          "description": "敬語の誤用検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableAdverbAgreement": {
          "type": "boolean",
          "default": true,
          "description": "副詞の呼応エラー検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableModifierPosition": {
          "type": "boolean",
          "default": true,
          "description": "修飾語の位置の問題検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableAmbiguousDemonstrative": {
          "type": "boolean",
          "default": true,
          "description": "曖昧な指示語の検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enablePassiveOveruse": {
          "type": "boolean",
          "default": true,
          "description": "受身表現の多用検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableNounChain": {
          "type": "boolean",
          "default": true,
          "description": "名詞の連続使用検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableConjunctionMisuse": {
          "type": "boolean",
          "default": true,
          "description": "接続詞の誤用検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableOkuriganaVariant": {
          "type": "boolean",
          "default": true,
          "description": "送り仮名の揺れ（「表わす」→「表す」など）の検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableOrthographyVariant": {
          "type": "boolean",
          "default": true,
          "description": "表記ゆれ（「出来る」→「できる」など）の検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableNumberWidthMix": {
          "type": "boolean",
          "default": true,
          "description": "全角/半角数字の混在検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableKatakanaChouon": {
          "type": "boolean",
          "default": true,
          "description": "カタカナ長音の揺れ（「サーバ」→「サーバー」など）の検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableHalfwidthKana": {
          "type": "boolean",
          "default": true,
          "description": "半角カナの検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableNumeralStyleMix": {
          "type": "boolean",
          "default": true,
          "description": "漢数字とアラビア数字の混在検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableSpaceAroundUnit": {
          "type": "boolean",
          "default": true,
          "description": "英字・数字・単位間のスペースの過不足検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableBracketQuoteMismatch": {
          "type": "boolean",
          "default": true,
          "description": "括弧・引用符の不一致検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableDateFormatVariant": {
          "type": "boolean",
          "default": true,
          "description": "日付表記の揺れの検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableDashTildeNormalization": {
          "type": "boolean",
          "default": true,
          "description": "ダッシュ・チルダの不統一検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableNakaguroUsage": {
          "type": "boolean",
          "default": true,
          "description": "中黒の過不足（「・・」など）の検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.enableSymbolWidthMix": {
          "type": "boolean",
          "default": true,
          "description": "全角/半角記号の混在検出の有効/無効",
          "scope": "resource"
        },
        "otakLsp.advanced.noParticleChainThreshold": {
          "type": "number",
          "default": 3,
          "minimum": 2,
          "maximum": 10,
          "description": "助詞「の」連続の閾値（この値以上で警告）",
          "scope": "resource"
        },
        "otakLsp.advanced.monotonousEndingThreshold": {
          "type": "number",
          "default": 3,
          "minimum": 2,
          "maximum": 10,
          "description": "文末表現の連続の閾値（この値以上で警告）",
          "scope": "resource"
        },
        "otakLsp.advanced.longSentenceThreshold": {
          "type": "number",
          "default": 120,
          "minimum": 50,
          "maximum": 500,
          "description": "長文と判定する文字数の閾値",
          "scope": "resource"
        },
        "otakLsp.advanced.nounChainThreshold": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "maximum": 20,
          "description": "名詞の連続使用の閾値（この値以上で警告）",
          "scope": "resource"
        },
        "otakLsp.advanced.passiveOveruseThreshold": {
          "type": "number",
          "default": 3,
          "minimum": 2,
          "maximum": 10,
          "description": "受身表現の多用の閾値（この値以上で警告）",
          "scope": "resource"
        },
        "otakLsp.advanced.enableSentenceEndingColon": {
          "type": "boolean",
          "default": true,
          "description": "文末コロン検出の有効/無効（日本語文の末尾に全角コロンが使用されている場合に警告）",
          "scope": "resource"
        },
        "otakLsp.advanced.enablePunctuationStyleMix": {
          "type": "boolean",
          "default": true,
          "description": "句読点スタイル混在検出の有効/無効（、。と，．の混在を検出）",
          "scope": "resource"
        },
        "otakLsp.advanced.enableQuotationStyleMix": {
          "type": "boolean",
          "default": true,
          "description": "引用符スタイル混在検出の有効/無効（「」と\"\"と''の混在を検出）",
          "scope": "resource"
        },
        "otakLsp.advanced.enableBulletStyleMix": {
          "type": "boolean",
          "default": true,
          "description": "箇条書き記号混在検出の有効/無効（・と-と*の混在を検出）",
          "scope": "resource"
        },
        "otakLsp.advanced.enableEmphasisStyleMix": {
          "type": "boolean",
          "default": true,
          "description": "強調記号混在検出の有効/無効（**と__の混在を検出）",
          "scope": "resource"
        },
        "otakLsp.advanced.enableEnglishCaseMix": {
          "type": "boolean",
          "default": true,
          "description": "英語表記大文字小文字混在検出の有効/無効（api/API/Apiなどの混在を検出）",
          "scope": "resource"
        },
        "otakLsp.advanced.enableUnitNotationMix": {
          "type": "boolean",
          "default": true,
          "description": "単位表記混在検出の有効/無効（km/hとキロメートルの混在を検出）",
          "scope": "resource"
        },
        "otakLsp.advanced.enablePronounMix": {
          "type": "boolean",
          "default": true,
          "description": "人称代名詞混在検出の有効/無効（私/僕/自分/当方の混在を検出）",
          "scope": "resource"
        },
        "otakLsp.advanced.enableHeadingLevelSkip": {
          "type": "boolean",
          "default": true,
          "description": "見出しレベル飛び検出の有効/無効（h1の次にh3などの飛びを検出）",
          "scope": "resource"
        },
        "otakLsp.advanced.enableTableColumnMismatch": {
          "type": "boolean",
          "default": true,
          "description": "テーブル列数不一致検出の有効/無効（Markdownテーブルの列数不一致を検出）",
          "scope": "resource"
        },
        "otakLsp.advanced.enableCodeBlockLanguage": {
          "type": "boolean",
          "default": true,
          "description": "コードブロック言語指定欠落検出の有効/無効（言語指定のないコードブロックを検出）",
          "scope": "resource"
        }
      }
    },
    "semanticTokenTypes": [
      {
        "id": "noun",
        "description": "名詞",
        "superType": "variable"
      },
      {
        "id": "verb",
        "description": "動詞",
        "superType": "function"
      },
      {
        "id": "adjective",
        "description": "形容詞",
        "superType": "property"
      },
      {
        "id": "particle",
        "description": "助詞",
        "superType": "keyword"
      },
      {
        "id": "adverb",
